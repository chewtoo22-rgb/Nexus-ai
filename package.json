{
  "name": "nexus-ai",
  "version": "3.0.1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --remote",
    "deploy": "wrangler deploy",
    "setup": "bash setup.sh",
    "db:init": "wrangler d1 migrations apply nemotron-nexus-db --remote",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "check:model-routing": "node scripts/check-model-routing.mjs",
    "check:agent-persistence": "node scripts/check-agent-persistence.mjs",
    "check:security-routes": "node scripts/check-security-routes.mjs"
  },
  "dependencies": {
    "agents": "^0.33.0",
    "@cloudflare/voice": "latest",
    "ai": "^7.0.0",
    "workers-ai-provider": "^4.0.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@cloudflare/sandbox": "^0.12.0",
    "parse5": "^7.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.1"
  }
}
